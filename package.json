{
  "name": "computer-access-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local desktop history service, web control panel, and scoped MCP server.",
  "bin": {
    "computer-access-mcp": "./dist/server/cli.js"
  },
  "types": "./dist/shared/api-types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/shared/api-types.d.ts",
      "default": "./dist/shared/api-types.js"
    },
    "./protocol": {
      "types": "./dist/shared/protocol/generated.d.ts",
      "default": "./dist/shared/protocol/generated.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "native-bin",
    "native/storage-lock/LICENSE.node",
    "native/storage-lock/README.md",
    "layout-guides",
    "locale",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build.mjs --native",
    "build:client": "node scripts/build-client.mjs",
    "build:storage-lock": "node scripts/build-storage-lock.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "schema:check": "node scripts/generate-protocol.mjs --check",
    "test": "node --test tests/contract/*.test.ts tests/privacy/*.test.ts tests/storage/*.test.ts tests/server/*.test.ts tests/integration/*.test.ts",
    "test:swift": "swift test --package-path native/macos/contract",
    "test:cross": "node scripts/test-cross-language.mjs",
    "serve": "node ./dist/server/cli.js serve"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.10.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
