  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/web/**"]
}
