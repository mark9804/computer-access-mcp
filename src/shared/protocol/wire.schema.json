{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:computer-access-mcp:wire:1",
  "title": "Computer Access Wire v1",
  "oneOf": [
    {
      "$ref": "#/$defs/Hello"
    },
    {
      "$ref": "#/$defs/Configure"
    },
    {
      "$ref": "#/$defs/Configured"
    },
    {
      "$ref": "#/$defs/Control"
    },
    {
      "$ref": "#/$defs/State"
    },
    {
      "$ref": "#/$defs/Observation"
    },
    {
      "$ref": "#/$defs/ActionRequest"
    },
    {
      "$ref": "#/$defs/ActionReceipt"
    },
    {
      "$ref": "#/$defs/ProtocolFailure"
    }
  ],
  "$defs": {
    "TargetIdentity": {
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "osSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "desktopId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "processId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "processStartTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-maxUtf16CodeUnits": 256
        },
        "windowId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "windowGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "deviceId",
        "osSessionId",
        "desktopId",
        "processId",
        "processStartTime",
        "applicationId",
        "windowId",
        "windowGeneration"
      ],
      "additionalProperties": false
    },
    "ApplicationTargetIdentity": {
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "osSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "desktopId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "processId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "processStartTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-maxUtf16CodeUnits": 256
        }
      },
      "required": [
        "deviceId",
        "osSessionId",
        "desktopId",
        "processId",
        "processStartTime",
        "applicationId"
      ],
      "additionalProperties": false
    },
    "ResolvedTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "resolved"
        },
        "identity": {
          "$ref": "#/$defs/TargetIdentity"
        }
      },
      "required": [
        "kind",
        "identity"
      ],
      "additionalProperties": false
    },
    "ApplicationTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "application"
        },
        "identity": {
          "$ref": "#/$defs/ApplicationTargetIdentity"
        }
      },
      "required": [
        "kind",
        "identity"
      ],
      "additionalProperties": false
    },
    "UnresolvedTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "unresolved"
        },
        "reason": {
          "type": "string",
          "enum": [
            "not-observed",
            "focus-unavailable",
            "policy-boundary",
            "desktop-unavailable"
          ]
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false
    },
    "TargetRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/ResolvedTarget"
        },
        {
          "$ref": "#/$defs/ApplicationTarget"
        },
        {
          "$ref": "#/$defs/UnresolvedTarget"
        }
      ]
    },
    "Stamp": {
      "type": "object",
      "properties": {
        "captureEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "foregroundGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "focusGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "captureEpoch",
        "foregroundGeneration",
        "focusGeneration",
        "policyRevision"
      ],
      "additionalProperties": false
    },
    "Capability": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "text.snapshot",
            "text.visible-range",
            "text.marker",
            "field.denylist",
            "ax.enablement",
            "surface.snapshot",
            "selection.snapshot",
            "input.text",
            "input.activity",
            "text.set",
            "pointer.click",
            "key.chord",
            "scroll",
            "gesture.pinch",
            "gesture.rotate",
            "gesture.pan",
            "gesture.swipe",
            "contact.touch",
            "contact.pen",
            "view.zoom"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "observe",
            "act",
            "verify"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "app-local",
            "authorized-desktop"
          ]
        },
        "support": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "x-maxUtf16CodeUnits": 256
        }
      },
      "required": [
        "name",
        "direction",
        "scope",
        "support",
        "reason"
      ],
      "additionalProperties": false
    },
    "CapturePolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedApplicationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf16CodeUnits": 256
          },
          "minItems": 0,
          "maxItems": 64
        },
        "applicationScope": {
          "type": "string",
          "enum": [
            "allowlist",
            "denylist"
          ],
          "default": "allowlist"
        },
        "excludedApplicationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf16CodeUnits": 256
          },
          "minItems": 0,
          "maxItems": 64
        },
        "allowBrowserContent": {
          "type": "boolean",
          "default": false
        },
        "fieldSecurity": {
          "type": "string",
          "enum": [
            "strict",
            "denylist"
          ],
          "default": "strict"
        },
        "axCompatibility": {
          "type": "boolean",
          "default": false
        },
        "textMarkers": {
          "type": "boolean",
          "default": false
        },
        "captureScope": {
          "type": "string",
          "enum": [
            "focused",
            "region",
            "window"
          ],
          "default": "focused"
        },
        "maxTreeNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 96,
          "default": 64
        },
        "inputText": {
          "type": "boolean",
          "default": false
        },
        "selectionCapture": {
          "type": "boolean",
          "default": false
        },
        "inputActivity": {
          "type": "boolean",
          "default": false
        },
        "textRange": {
          "type": "string",
          "enum": [
            "prefix",
            "visible"
          ],
          "default": "prefix"
        },
        "sampleIntervalMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000,
          "default": 1000
        },
        "maxTextCodeUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "maxPending": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "debounceMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "maxWaitMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "readTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      },
      "required": [
        "enabled",
        "allowedApplicationIds",
        "maxTextCodeUnits",
        "maxPending",
        "debounceMs",
        "maxWaitMs",
        "readTimeoutMs"
      ],
      "additionalProperties": false
    },
    "Hello": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "hello"
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "maxFrameBytes": {
          "const": 65536
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "instanceId",
        "capabilities",
        "maxFrameBytes"
      ],
      "additionalProperties": false
    },
    "Configure": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "configure"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy": {
          "$ref": "#/$defs/CapturePolicy"
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "ownerId",
        "instanceId",
        "policyRevision",
        "policy"
      ],
      "additionalProperties": false
    },
    "Configured": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "configured"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "ownerId",
        "instanceId",
        "policyRevision"
      ],
      "additionalProperties": false
    },
    "Control": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "control"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "command": {
          "type": "string",
          "enum": [
            "start",
            "pause",
            "resume",
            "stop",
            "heartbeat"
          ]
        },
        "leaseDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "ownerId",
        "instanceId",
        "policyRevision",
        "command",
        "leaseDurationMs"
      ],
      "additionalProperties": false
    },
    "CaptureDiagnostics": {
      "type": "object",
      "properties": {
        "axEnablement": {
          "type": "string",
          "enum": [
            "disabled",
            "denied",
            "already-enabled",
            "enabled",
            "unsupported",
            "original-unknown",
            "not-settable",
            "write-failed"
          ]
        },
        "axAttribute": {
          "type": "string",
          "enum": [
            "manual",
            "enhanced",
            "none"
          ]
        },
        "observer": {
          "type": "string",
          "enum": [
            "unavailable",
            "best-effort"
          ]
        }
      },
      "required": [
        "axEnablement",
        "axAttribute",
        "observer"
      ],
      "additionalProperties": false
    },
    "State": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "state"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "state": {
          "type": "string",
          "enum": [
            "unconfigured",
            "ready",
            "running",
            "paused",
            "stopped"
          ]
        },
        "stamp": {
          "$ref": "#/$defs/Stamp"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "x-maxUtf16CodeUnits": 256
        },
        "captureDiagnostics": {
          "$ref": "#/$defs/CaptureDiagnostics"
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "instanceId",
        "state",
        "stamp",
        "reason"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "missingReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-maxUtf16CodeUnits": 128
          },
          "minItems": 0,
          "maxItems": 16
        }
      },
      "required": [
        "status",
        "truncated",
        "missingReasons"
      ],
      "additionalProperties": false
    },
    "TextRange": {
      "type": "object",
      "properties": {
        "unit": {
          "const": "utf16"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        }
      },
      "required": [
        "unit",
        "start",
        "length"
      ],
      "additionalProperties": false
    },
    "ContentGate": {
      "type": "object",
      "properties": {
        "secure": {
          "type": "string",
          "enum": [
            "safe",
            "not-declared-sensitive",
            "sensitive",
            "unknown"
          ]
        },
        "privateState": {
          "type": "string",
          "enum": [
            "normal",
            "private",
            "unknown",
            "user-authorized"
          ]
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "secure",
        "privateState",
        "policyRevision"
      ],
      "additionalProperties": false
    },
    "TextSnapshot": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "text.snapshot"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "editSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "source": {
          "type": "string",
          "enum": [
            "fixture",
            "ax.value",
            "ax.range",
            "ax.marker",
            "uia.value",
            "uia.text"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "field",
            "accessible-range"
          ]
        },
        "valueState": {
          "type": "string",
          "enum": [
            "read",
            "unavailable",
            "redacted"
          ]
        },
        "rangeBasis": {
          "type": "string",
          "enum": [
            "prefix",
            "visible"
          ],
          "default": "prefix"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8192,
          "x-maxUtf16CodeUnits": 8192
        },
        "range": {
          "$ref": "#/$defs/TextRange"
        },
        "selection": {
          "$ref": "#/$defs/TextRange"
        },
        "totalLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "composition": {
          "type": "string",
          "enum": [
            "composing",
            "not-composing",
            "unknown"
          ]
        },
        "captureStartMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "captureEndMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "gate": {
          "$ref": "#/$defs/ContentGate"
        }
      },
      "required": [
        "kind",
        "snapshotId",
        "editSessionId",
        "nodeId",
        "source",
        "scope",
        "valueState",
        "composition",
        "captureStartMs",
        "captureEndMs",
        "coverage"
      ],
      "additionalProperties": false
    },
    "TextChanged": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "text.changed"
        },
        "baseSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128
        },
        "after": {
          "$ref": "#/$defs/TextSnapshot"
        }
      },
      "required": [
        "kind",
        "baseSnapshotId",
        "after"
      ],
      "additionalProperties": false
    },
    "InputActivityCounts": {
      "type": "object",
      "properties": {
        "pointerReleases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "dragSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "scrollSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "shortcutPresses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "required": [
        "pointerReleases",
        "dragSamples",
        "scrollSamples",
        "shortcutPresses"
      ],
      "additionalProperties": false
    },
    "InputActivityGate": {
      "type": "object",
      "properties": {
        "policyRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "secureInput": {
          "const": "inactive"
        },
        "targetAttribution": {
          "const": "event-target-pid"
        },
        "detail": {
          "const": "coarse-counts"
        }
      },
      "required": [
        "policyRevision",
        "secureInput",
        "targetAttribution",
        "detail"
      ],
      "additionalProperties": false
    },
    "InputActivity": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "input.activity"
        },
        "source": {
          "type": "string",
          "enum": [
            "cg.listen-only",
            "fixture"
          ]
        },
        "scope": {
          "const": "application"
        },
        "intervalStartMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "intervalEndMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "counts": {
          "$ref": "#/$defs/InputActivityCounts"
        },
        "gate": {
          "$ref": "#/$defs/InputActivityGate"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        }
      },
      "required": [
        "kind",
        "source",
        "scope",
        "intervalStartMs",
        "intervalEndMs",
        "counts",
        "gate",
        "coverage"
      ],
      "additionalProperties": false
    },
    "SurfaceBounds": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
